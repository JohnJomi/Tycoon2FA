# Copy to .env and fill in locally. .env is gitignored; never commit real values.

# --- Gmail OAuth (ARCHITECTURE.md section 3) ---
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
# Keep it inside .credentials/, which is gitignored.
GOOGLE_CLIENT_SECRETS_FILE=.credentials/client_secret.json
# Where the cached user token is written after the installed-app flow.
GMAIL_TOKEN_FILE=.credentials/token.json

# --- Local paths ---
CACHE_DB_PATH=storage/cache.db
WEIGHTS_CONFIG=config/weights.yaml
MODELS_DIR=models

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# --- Threat intel feeds (Layer 4, Phase 4) ---
# Free feeds. Leave blank until the layer is actually implemented.
URLHAUS_API_KEY=
PHISHTANK_API_KEY=
